# ===================================
# STAGING ENVIRONMENT CONFIGURATION
# ===================================
# ALL variables are REQUIRED - no defaults
# The service will fail to start if any are missing
# ===================================

# Server Configuration
PORT=8081
ENVIRONMENT=staging

# Database Configuration
DB_HOST=your-db-host.railway.app
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=payment_service
DB_SSL_MODE=require
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ===================================
# EPX PAYMENT GATEWAY (SANDBOX)
# ===================================
EPX_SERVER_POST_ENDPOINT=https://secure.epxuap.com
EPX_SERVER_POST_SOCKET_ENDPOINT=secure.epxuap.com:8087
EPX_KEY_EXCHANGE_ENDPOINT=https://keyexch.epxuap.com
EPX_BROWSER_POST_ENDPOINT=https://services.epxuap.com/browserpost/
EPX_TIMEOUT=30

# EPX Sandbox Credentials
EPX_CUST_NBR=9001
EPX_MERCH_NBR=900300
EPX_DBA_NBR=2
EPX_TERMINAL_NBR=77

# EPX Sandbox MAC (for callback authentication)
EPX_SANDBOX_MAC=your_sandbox_mac_here

# ===================================
# NORTH MERCHANT REPORTING API
# ===================================
NORTH_MERCHANT_REPORTING_URL=https://api.north.com
NORTH_TIMEOUT=30

# Browser Post Configuration
CALLBACK_BASE_URL=https://your-app-name.up.railway.app

# ===================================
# CRON CONFIGURATION
# ===================================
# Generate with: openssl rand -base64 32
CRON_SECRET=your-staging-secret-minimum-32-characters
CRON_JOB_TIMEOUT_SECONDS=300
CRON_DEFAULT_BATCH_SIZE=100
CRON_MAX_BATCH_SIZE=1000

# ===================================
# SUBSCRIPTION CONFIGURATION
# ===================================
SUBSCRIPTION_DEFAULT_MAX_RETRIES=3
SUBSCRIPTION_DEFAULT_GRACE_PERIOD_DAYS=30
SUBSCRIPTION_RETRY_BASE_DELAY_SECS=300
SUBSCRIPTION_RETRY_MAX_DELAY_SECS=7200
SUBSCRIPTION_RETRY_MULTIPLIER=2.0
# RS_WINDOW_DAYS: Window for retrying a failed recurring billing transaction with ACI_EXT=RS.
# COMPLIANCE: Visa/MC/Discover require RS retries within 30 days of original decline.
RS_WINDOW_DAYS=30

# ===================================
# AUTHENTICATION
# ===================================
AUTH_SALT_PREFIX=payment_service_staging_
AUTH_ENABLED=true

# Logging
LOG_LEVEL=debug

# ===================================
# SECRET MANAGER CONFIGURATION
# ===================================
SECRET_MANAGER=mock
SECRET_CACHE_TTL_MINUTES=5
