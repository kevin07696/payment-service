# =====================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================
# ALL variables are REQUIRED - no defaults
# The service will fail to start if any are missing
# =====================================

# Server Configuration
PORT=8081
ENVIRONMENT=production

# Database Configuration
DB_HOST=your-prod-db-host
DB_PORT=5432
DB_USER=your_prod_user
DB_PASSWORD=your_prod_password
DB_NAME=payment_service
DB_SSL_MODE=require     # MUST be 'require' or 'verify-full' in production
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ===================================
# EPX PAYMENT GATEWAY (PRODUCTION)
# ===================================
# Contact North for production endpoint URLs
EPX_SERVER_POST_ENDPOINT=https://your-prod-server-post-url
EPX_SERVER_POST_SOCKET_ENDPOINT=your-prod-socket:8086
EPX_KEY_EXCHANGE_ENDPOINT=https://your-prod-key-exchange-url
EPX_BROWSER_POST_ENDPOINT=https://your-prod-browser-post-url
EPX_TIMEOUT=30

# EPX Production Credentials - Contact North for values
EPX_CUST_NBR=YOUR_PROD_CUST_NBR
EPX_MERCH_NBR=YOUR_PROD_MERCH_NBR
EPX_DBA_NBR=YOUR_PROD_DBA_NBR
EPX_TERMINAL_NBR=YOUR_PROD_TERMINAL_NBR

# EPX Sandbox MAC (optional - production uses per-merchant MACs from database)
# EPX_SANDBOX_MAC=

# ===================================
# NORTH MERCHANT REPORTING API
# ===================================
NORTH_MERCHANT_REPORTING_URL=https://api.north.com
NORTH_TIMEOUT=30

# Browser Post Configuration
CALLBACK_BASE_URL=https://payments.yourdomain.com

# ===================================
# CRON CONFIGURATION
# ===================================
# Generate with: openssl rand -base64 32
CRON_SECRET=YOUR_PRODUCTION_SECRET_MINIMUM_32_CHARS
CRON_JOB_TIMEOUT_SECONDS=300
CRON_DEFAULT_BATCH_SIZE=100
CRON_MAX_BATCH_SIZE=1000

# ===================================
# SUBSCRIPTION CONFIGURATION
# ===================================
SUBSCRIPTION_DEFAULT_MAX_RETRIES=3
SUBSCRIPTION_DEFAULT_GRACE_PERIOD_DAYS=30
SUBSCRIPTION_RETRY_BASE_DELAY_SECS=300
SUBSCRIPTION_RETRY_MAX_DELAY_SECS=7200
SUBSCRIPTION_RETRY_MULTIPLIER=2.0
# RS_WINDOW_DAYS: Window for retrying a failed recurring billing transaction with ACI_EXT=RS.
# COMPLIANCE: Visa/MC/Discover require RS retries within 30 days of original decline.
RS_WINDOW_DAYS=30

# ===================================
# AUTHENTICATION
# ===================================
AUTH_SALT_PREFIX=payment_service_prod_
AUTH_ENABLED=true       # MUST be true in production

# Logging
LOG_LEVEL=info

# ===================================
# SECRET MANAGER CONFIGURATION
# ===================================
SECRET_MANAGER=gcp
SECRET_CACHE_TTL_MINUTES=5
GCP_PROJECT_ID=your-gcp-project-production
