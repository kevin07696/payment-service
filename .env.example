# ===================================
# PAYMENT SERVICE - ENVIRONMENT VARIABLES
# ===================================
# ALL variables are REQUIRED - no defaults
# The service will fail to start if any are missing
# ===================================

# Server Configuration
PORT=8081               # Server port (ConnectRPC + REST)

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=payment_service
DB_SSL_MODE=disable     # Use 'require' or 'verify-full' for production
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Full Database URL (used by paycli CLI and goose migrations; server uses individual DB_* variables above)
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/payment_service?sslmode=disable

# ===================================
# EPX PAYMENT GATEWAY
# ===================================
# Endpoint URLs - sandbox values shown, production requires different URLs
# Production endpoints provided by North during certification

# EPX Endpoints (sandbox defaults used when ENVIRONMENT=sandbox)
# For non-sandbox, set these environment variables:
EPX_SERVER_POST_ENDPOINT=https://secure.epxuap.com
EPX_SERVER_POST_SOCKET_ENDPOINT=secure.epxuap.com:8087
EPX_KEY_EXCHANGE_ENDPOINT=https://keyexch.epxuap.com
EPX_BROWSER_POST_ENDPOINT=https://services.epxuap.com/browserpost/

EPX_TIMEOUT=30

# Sandbox Merchant Identity (auto-seeded on startup in dev/staging)
SANDBOX_MERCHANT_ID=00000000-0000-0000-0000-000000000001
SANDBOX_MERCHANT_SLUG=sandbox-merchant
SANDBOX_MERCHANT_NAME=Sandbox Merchant

# EPX Sandbox Credentials
EPX_CUST_NBR=9001
EPX_MERCH_NBR=900300
EPX_DBA_NBR=2
EPX_TERMINAL_NBR=77
EPX_SANDBOX_MAC=your_sandbox_mac_here

# ===================================
# NORTH MERCHANT REPORTING API
# ===================================
# Used for: disputes, chargebacks (NOT for payments)
NORTH_MERCHANT_REPORTING_URL=https://api.north.com
NORTH_TIMEOUT=30

# Browser Post Configuration
CALLBACK_BASE_URL=http://localhost:8080

# ===================================
# CRON CONFIGURATION
# ===================================
# CRON_SECRET must be at least 32 characters
# Generate with: openssl rand -base64 32
CRON_SECRET=your-32-character-minimum-secret-here
CRON_JOB_TIMEOUT_SECONDS=300
CRON_DEFAULT_BATCH_SIZE=100
CRON_MAX_BATCH_SIZE=1000

# ===================================
# SUBSCRIPTION CONFIGURATION
# ===================================
SUBSCRIPTION_DEFAULT_MAX_RETRIES=3
SUBSCRIPTION_DEFAULT_GRACE_PERIOD_DAYS=30
SUBSCRIPTION_RETRY_BASE_DELAY_SECS=300
SUBSCRIPTION_RETRY_MAX_DELAY_SECS=7200
SUBSCRIPTION_RETRY_MULTIPLIER=2.0

# ===================================
# AUTHENTICATION
# ===================================
AUTH_SALT_PREFIX=payment_service_
AUTH_ENABLED=true       # Set to 'false' only for local development

# Environment
ENVIRONMENT=development  # development, staging, production

# Logging
LOG_LEVEL=debug         # debug, info, warn, error

# ===================================
# SECRET MANAGER CONFIGURATION
# ===================================
SECRET_MANAGER=mock     # Options: 'mock' (dev), 'gcp' (production)
SECRET_CACHE_TTL_MINUTES=5
