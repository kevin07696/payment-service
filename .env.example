# ===================================
# PAYMENT SERVICE - ENVIRONMENT VARIABLES
# ===================================
# ALL variables are REQUIRED unless marked (optional)
# The service will fail to start if any required vars are missing
# Missing required vars are reported together (better DX)
# ===================================

# Server Configuration
PORT=8081               # REQUIRED: Server port (ConnectRPC + REST)
ENVIRONMENT=development # REQUIRED: development, staging, production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=payment_service
DB_SSL_MODE=disable     # Use 'require' or 'verify-full' for production
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Full Database URL (used by paycli CLI and goose migrations; server uses individual DB_* variables above)
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/payment_service?sslmode=disable

# Test Database URL (used by integration tests that require a real database connection)
# Set this to run database integration tests: go test -race ./...
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_service?sslmode=disable

# ===================================
# EPX PAYMENT GATEWAY
# ===================================
# Endpoint URLs - sandbox values shown, production requires different URLs
# Production endpoints provided by North during certification

# EPX Endpoints (sandbox defaults used when ENVIRONMENT=sandbox)
# For non-sandbox, set these environment variables:
EPX_SERVER_POST_ENDPOINT=https://secure.epxuap.com
EPX_SERVER_POST_SOCKET_ENDPOINT=secure.epxuap.com:8087
EPX_KEY_EXCHANGE_ENDPOINT=https://keyexch.epxuap.com
EPX_BROWSER_POST_ENDPOINT=https://services.epxuap.com/browserpost/

EPX_TIMEOUT=30

# Sandbox Merchant Identity (auto-seeded on startup in dev/staging)
SANDBOX_MERCHANT_ID=00000000-0000-0000-0000-000000000001
SANDBOX_MERCHANT_SLUG=sandbox-merchant
SANDBOX_MERCHANT_NAME=Sandbox Merchant

# EPX Sandbox Credentials
EPX_CUST_NBR=9001
EPX_MERCH_NBR=900300
EPX_DBA_NBR=2
EPX_TERMINAL_NBR=77
EPX_SANDBOX_MAC=your_sandbox_mac_here  # (optional) MAC for sandbox callback auth

# EPX API Credentials (optional - for Business Reporting API)
EPX_API_KEY=          # (optional) API key for Business Reporting
EPX_API_SECRET=       # (optional) API secret for Business Reporting

# ===================================
# NORTH MERCHANT REPORTING API
# ===================================
# Used for: disputes, chargebacks (NOT for payments)
NORTH_MERCHANT_REPORTING_URL=https://api.north.com
NORTH_TIMEOUT=30

# Browser Post Configuration
CALLBACK_BASE_URL=http://localhost:8080

# ===================================
# CRON CONFIGURATION
# ===================================
# CRON_SECRET must be at least 32 characters
# Generate with: openssl rand -base64 32
CRON_SECRET=your-32-character-minimum-secret-here
CRON_JOB_TIMEOUT_SECONDS=300
CRON_DEFAULT_BATCH_SIZE=100
CRON_MAX_BATCH_SIZE=1000

# ===================================
# SUBSCRIPTION CONFIGURATION
# ===================================
SUBSCRIPTION_DEFAULT_MAX_RETRIES=3
SUBSCRIPTION_DEFAULT_GRACE_PERIOD_DAYS=30
SUBSCRIPTION_RETRY_BASE_DELAY_SECS=300
SUBSCRIPTION_RETRY_MAX_DELAY_SECS=7200
SUBSCRIPTION_RETRY_MULTIPLIER=2.0

# ===================================
# AUTHENTICATION
# ===================================
AUTH_SALT_PREFIX=payment_service_
AUTH_ENABLED=true       # Set to 'false' only for local development

# ===================================
# SECURITY CONFIGURATION
# ===================================
# Trusted Proxies - comma-separated list of IP addresses that can set X-Forwarded-For headers
# Set this to your load balancer/reverse proxy IPs in production
# Example: "10.0.0.1,10.0.0.2,192.168.1.100"
TRUSTED_PROXIES=       # (optional) Can be empty - only trust direct client IP

# Allowed Return Domains - comma-separated list of domains for Browser Post return URLs
# Prevents open redirect attacks by restricting where users can be redirected after payment
# Example: "example.com,app.example.com,mysite.org"
# REQUIRED in production - causes startup failure if empty in production
ALLOWED_RETURN_DOMAINS=

# Logging
LOG_LEVEL=debug         # debug, info, warn, error (used by logger config)

# ===================================
# OBSERVABILITY CONFIGURATION (optional)
# ===================================
# These have sensible defaults and are optional

# Prometheus Metrics
METRICS_ENABLED=true    # (optional) Defaults to true
METRICS_PORT=9090       # (optional) Defaults to 9090

# OpenTelemetry Distributed Tracing
TRACING_ENABLED=false   # (optional) Defaults to false
TRACING_SAMPLE_RATE=0.1 # (optional) Defaults to 0.1 (10%)
OTLP_ENDPOINT=localhost:4318 # (optional) Defaults to localhost:4318

# ===================================
# SECRET MANAGER CONFIGURATION
# ===================================
SECRET_MANAGER=mock     # Options: 'mock' (dev), 'local' (dev with real creds), 'gcp', 'aws', 'vault' (production)
SECRET_CACHE_TTL_MINUTES=5
